# Create React App inlines images under 10 KB as base64 inside main.js.
# The thirteen boot proofs are 5-9 KB each, so they landed in the bundle
# that blocks first render — 91 KB of render-blocking JavaScript to save
# thirteen requests. Emitting them as files instead keeps them cacheable,
# parallel, and out of the critical path.
IMAGE_INLINE_SIZE_LIMIT=0
